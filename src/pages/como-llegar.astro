---
import BaseLayout from '@layouts/BaseLayout.astro';

const title = "Cómo Llegar a Fernet Limpiezas en Badalona";
const description = "Encuentra la mejor ruta para llegar a nuestras oficinas en Badalona. Proporcionamos indicaciones detalladas y opciones de transporte público.";
const keywords = "cómo llegar a fernet limpiezas, dirección fernet limpiezas, mapa fernet limpiezas, transporte público badalona, llegar a avenida alfonso xiii badalona";
const canonical = "https://www.limpiezasfernet.com/como-llegar.html";
const esLink = "https://www.limpiezasfernet.com/como-llegar.html";
const caLink = "https://www.limpiezasfernet.com/ca/com-arribar.html";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Cómo Llegar a Fernet Limpiezas",
    "description": "Instrucciones detalladas para llegar a las oficinas de Fernet Limpiezas en Badalona, incluyendo un mapa interactivo y opciones de transporte público.",
    "url": "https://www.limpiezasfernet.com/como-llegar.html",
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://www.limpiezasfernet.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Cómo Llegar"
        }
      ]
    }
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  esLink={esLink}
  caLink={caLink}
  jsonLd={jsonLd}
  lang="es"
  basePath=""
  currentPage="como-llegar.html"
  extraCss={["contacto.css"]}
>
<section class="hero">
            <div class="container">
                <h1>Cómo Llegar a Nuestras Oficinas en Badalona</h1>
                <p>Te esperamos en Avenida Alfonso XIII, 107-109. Aquí te indicamos cómo encontrarnos.</p>
            </div>
        </section>
        <section class="como-llegar-section">
            <div class="container">
                <h2>Nuestra Ubicación</h2>
                <p><strong>Dirección:</strong> Avenida Alfonso XIII nº 107-109, 08912 Badalona, Barcelona</p>
                <div class="mapa-container">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d186.92799063288587!2d2.2344941250902495!3d41.442522940363624!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12a4bb688d13e77b%3A0x969d0e6a0c484cf0!2sFernet%20Limpiezas!5e0!3m2!1sen!2ses!4v1759411275703!5m2!1sen!2ses" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy" title="Mapa de ubicación de Fernet Limpiezas" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
                <div class="transporte-info">
                    <h3>Transporte Público Cercano</h3>
                    <ul>
                        <li><strong><i class="fas fa-bus"></i> Autobús:</strong> Las líneas de autobús B3, B25 y M28 tienen paradas a pocos minutos de nuestra oficina.</li>
                        <li><strong><i class="fas fa-subway"></i> Metro:</strong> La estación de metro más cercana es <strong>L2 - Sant Roc</strong>, que se encuentra a unos 10-15 minutos a pie.</li>
                        <li><strong><i class="fas fa-train"></i> Tren:</strong> La estación de Rodalies <strong>Sant Adrià de Besòs (R1)</strong> está a aproximadamente 20 minutos caminando.</li>
                    </ul>
                    <h3>Indicaciones para Llegar en Coche</h3>
                    <p>Si vienes en coche, puedes acceder fácilmente desde la autopista C-31 (salida Badalona Sud). Hay aparcamiento disponible en las calles cercanas, aunque puede ser limitado en horas punta.</p>
                </div>
            </div>
        </section>
</BaseLayout>
