---
import BaseLayout from '@layouts/BaseLayout.astro';

const title = "Tarifas de Limpieza en Badalona | Fernet Limpiezas";
const description = "Tarifas orientativas de limpieza en Badalona para comunidades, oficinas y viviendas. Consulta las condiciones y pide una propuesta para tu caso.";
const keywords = "tarifas limpieza badalona, precios limpieza, limpieza barata badalona, fernet limpiezas tarifas";
const canonical = "https://www.limpiezasfernet.com/tarifas.html";
const esLink = "https://www.limpiezasfernet.com/tarifas.html";
const caLink = "https://www.limpiezasfernet.com/ca/tarifes.html";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Fernet Limpiezas",
    "@id": "https://www.limpiezasfernet.com/#localbusiness",
    "image": "https://www.limpiezasfernet.com/img/logo.jpg",
    "url": "https://www.limpiezasfernet.com/tarifas.html",
    "telephone": "+34931050338",
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": [
          "https://schema.org/Monday",
          "https://schema.org/Tuesday",
          "https://schema.org/Wednesday",
          "https://schema.org/Thursday",
          "https://schema.org/Friday"
        ],
        "opens": "09:00",
        "closes": "14:00"
      },
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": [
          "https://schema.org/Monday",
          "https://schema.org/Tuesday",
          "https://schema.org/Wednesday",
          "https://schema.org/Thursday",
          "https://schema.org/Friday"
        ],
        "opens": "16:30",
        "closes": "18:30"
      }
    ],
    "priceRange": "€€",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Avenida Alfonso XIII nº 107-109",
      "addressLocality": "Badalona",
      "postalCode": "08912",
      "addressRegion": "Barcelona",
      "addressCountry": "ES"
    },
    "description": "Tarifas orientativas de limpieza en Badalona para comunidades, oficinas y viviendas. Consulta las condiciones y solicita una propuesta.",
    "offers": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Limpieza de Comunidades",
          "description": "Servicio de limpieza y mantenimiento para comunidades de vecinos en Badalona, incluyendo escaleras, portales y zonas comunes."
        },
        "priceSpecification": {
          "@type": "PriceSpecification",
          "price": "180",
          "priceCurrency": "EUR",
          "unitText": "mes"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Limpieza de Oficinas",
          "description": "Servicio de limpieza profesional para oficinas y empresas en Badalona, por horas."
        },
        "priceSpecification": {
          "@type": "PriceSpecification",
          "price": "35",
          "priceCurrency": "EUR",
          "unitText": "hora"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Limpieza de Hogar",
          "description": "Servicio de limpieza doméstica por horas para particulares en Badalona."
        },
        "priceSpecification": {
          "@type": "PriceSpecification",
          "price": "30",
          "priceCurrency": "EUR",
          "unitText": "hora"
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Cuáles son las tarifas de limpieza de comunidades en Badalona?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "La limpieza de comunidades de vecinos en Badalona tiene una tarifa de referencia desde 180 € al mes, que abarca escaleras, portal, ascensor, vidrios y zonas comunes."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cuál es el precio por hora de limpieza de oficinas en Badalona?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "La limpieza profesional de oficinas y empresas en Badalona se ofrece desde 35 € la hora, incluyendo despachos, papeleras, sanitarios y zonas de descanso."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cuánto cuesta el abrillantado de suelos por metro cuadrado?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "El tratamiento de abrillantado y cristalizado de suelos de mármol y terrazo parte desde 5,50 € por metro cuadrado."
        }
      },
      {
        "@type": "Question",
        "name": "¿Hay compromiso de permanencia en las tarifas?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No, Fernet Limpiezas ofrece contratos flexibles y presupuestos transparentes sin cláusulas de permanencia obligatoria."
        }
      }
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  esLink={esLink}
  caLink={caLink}
  jsonLd={jsonLd}
  lang="es"
  basePath=""
  currentPage="tarifas.html"
  extraCss={["tarifas.css"]}
>
<section class="tarifas-section">
        <div class="tarifas-heading">
            <h1 class="section-title">Tarifas de limpieza en Badalona</h1>
            <p class="tarifas-intro">Precios transparentes y sin permanencia. Consulta nuestras tarifas de referencia y solicita una propuesta a tu medida en menos de 24 horas.</p>
        </div>
        <div class="tarifas-grid">
            <article class="tarifa-card">
                <h2>Limpieza de comunidades</h2>
                <p class="precio" aria-label="Desde 180 euros al mes">
                    <span class="precio-prefijo">desde</span><strong>180€</strong><span class="precio-unidad">/mes*</span>
                </p>
                <ul>
                    <li>Limpieza de escalera</li>
                    <li>Mantenimiento de portal</li>
                    <li>Limpieza de cristales</li>
                </ul>
                <a href="contacto.html" class="cta-button">Solicitar presupuesto</a>
            </article>

            <article class="tarifa-card">
                <h2>Limpieza de oficinas</h2>
                <p class="precio" aria-label="Desde 35 euros por hora">
                    <span class="precio-prefijo">desde</span><strong>35€</strong><span class="precio-unidad">/hora*</span>
                </p>
                <ul>
                    <li>Limpieza de despachos</li>
                    <li>Vaciado de papeleras</li>
                    <li>Zonas comunes</li>
                </ul>
                <a href="contacto.html" class="cta-button">Solicitar presupuesto</a>
            </article>

            <article class="tarifa-card">
                <h2>Limpieza de hogar</h2>
                <p class="precio" aria-label="Desde 30 euros por hora">
                    <span class="precio-prefijo">desde</span><strong>30€</strong><span class="precio-unidad">/hora*</span>
                </p>
                <ul>
                    <li>Limpieza general</li>
                    <li>Servicio por horas</li>
                    <li>Plancha y colada (opcional)</li>
                </ul>
                <a href="contacto.html" class="cta-button">Solicitar presupuesto</a>
            </article>

            <article class="tarifa-card destacado">
                <p class="tarifa-etiqueta">Precio por superficie</p>
                <h2>Abrillantado y cristalizado de suelos</h2>
                <p class="precio" aria-label="Desde 5 euros y 50 céntimos por metro cuadrado">
                    <span class="precio-prefijo">desde</span><strong>5,5€</strong><span class="precio-unidad">/m²*</span>
                </p>
                <ul>
                    <li>Abrillantado profesional</li>
                    <li>Cristalizado de superficies</li>
                    <li>Ideal para comunidades y oficinas</li>
                </ul>
                <a href="contacto.html" class="cta-button cta-destacado">Solicitar presupuesto</a>
            </article>
        </div>

        <div class="disclaimer">
            <p><strong>* Tarifas de referencia transparentes.</strong> El importe exacto se adapta a la superficie, frecuencia y necesidades específicas de tu espacio.</p>
            <p>Pide tu valoración personalizada sin ningún tipo de compromiso.</p>
            <p><a href="precios.md">Consultar las tarifas en texto plano (Markdown)</a> | <a href="pricing.md">Machine-readable Pricing</a></p>
        </div>

        <div class="tarifas-faq" style="max-width: 900px; margin: 3rem auto 0; text-align: left; padding: 2rem; background: var(--surface); border-radius: 8px;">
            <h2>Preguntas frecuentes sobre tarifas en Badalona</h2>
            <article style="margin-bottom: 1.2rem;">
                <h3>¿Cuáles son las tarifas de limpieza de comunidades en Badalona?</h3>
                <p>La limpieza de comunidades de vecinos en Badalona tiene una tarifa de referencia desde 180 € al mes, que abarca escaleras, portal, ascensor, vidrios y zonas comunes.</p>
            </article>
            <article style="margin-bottom: 1.2rem;">
                <h3>¿Cuál es el precio por hora de limpieza de oficinas en Badalona?</h3>
                <p>La limpieza profesional de oficinas y empresas en Badalona se ofrece desde 35 € la hora, incluyendo despachos, papeleras, sanitarios y zonas de descanso.</p>
            </article>
            <article style="margin-bottom: 1.2rem;">
                <h3>¿Cuánto cuesta el abrillantado de suelos por metro cuadrado?</h3>
                <p>El tratamiento de abrillantado y cristalizado de suelos de mármol y terrazo parte desde 5,50 € por metro cuadrado.</p>
            </article>
            <article style="margin-bottom: 1.2rem;">
                <h3>¿Hay compromiso de permanencia en las tarifas?</h3>
                <p>No, Fernet Limpiezas ofrece contratos flexibles y presupuestos transparentes sin cláusulas de permanencia obligatoria.</p>
            </article>
        </div>
    </section>
</BaseLayout>
