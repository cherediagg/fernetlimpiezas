const keywords = "neteja pàrquings Badalona, neteja garatges Badalona, neteja pàrquings empresa Badalona";
const canonical = "https://www.limpiezasfernet.com/ca/serveis/neteja-parkings-badalona.html";
const esLink = "https://www.limpiezasfernet.com/servicios/limpieza-parkings-badalona.html";
const caLink = "https://www.limpiezasfernet.com/ca/serveis/neteja-parkings-badalona.html";
const jsonLd = [
  [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inici",
          "item": "https://www.limpiezasfernet.com/ca/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Serveis",
          "item": "https://www.limpiezasfernet.com/ca/#serveis"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Neteja de Pàrquings a Badalona",
          "item": "https://www.limpiezasfernet.com/ca/serveis/neteja-parkings-badalona.html"
        }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Neteja de Pàrquings a Badalona | Garatges i Aparcaments",
      "description": "Servei de neteja de pàrquings i garatges a Badalona. Realitzem escombrat i fregat mecànic per eliminar pols i taques d'oli. Demana pressupost!",
      "serviceType": "Neteja de Pàrquings",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Fernet Neteges",
        "url": "https://www.limpiezasfernet.com/ca/",
        "image": "https://www.limpiezasfernet.com/img/logo.jpg",
        "telephone": "+34931050338",
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "https://schema.org/Monday",
              "https://schema.org/Tuesday",
              "https://schema.org/Wednesday",
              "https://schema.org/Thursday",
              "https://schema.org/Friday"
            ],
            "opens": "09:00",
            "closes": "14:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "https://schema.org/Monday",
              "https://schema.org/Tuesday",
              "https://schema.org/Wednesday",
              "https://schema.org/Thursday",
              "https://schema.org/Friday"
            ],
            "opens": "16:30",
            "closes": "18:30"
          }
        ],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Avinguda Alfons XIII núm. 107-109",
          "addressLocality": "Badalona",
          "postalCode": "08912",
          "addressCountry": "ES"
        }
      },
      "areaServed": {
