---
import BaseLayout from '@layouts/BaseLayout.astro';

const title = "Neteja de comerços a Badalona | Fernet Neteges";
const description = "Servei de neteja de comerços a Badalona. Deixem la teva botiga o local impecable: aparadors, terres i àrees d'atenció al client. Demana pressupost!";
const keywords = "neteja comerços Badalona, neteja botigues Badalona, neteja aparadors Badalona";
const canonical = "https://www.limpiezasfernet.com/ca/serveis/neteja-comercos-badalona.html";
const esLink = "https://www.limpiezasfernet.com/servicios/limpieza-comercios-badalona.html";
const caLink = "https://www.limpiezasfernet.com/ca/serveis/neteja-comercos-badalona.html";
const jsonLd = [
  [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inici",
          "item": "https://www.limpiezasfernet.com/ca/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Serveis",
          "item": "https://www.limpiezasfernet.com/ca/#serveis"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Neteja de Comerços a Badalona",
          "item": "https://www.limpiezasfernet.com/ca/serveis/neteja-comercos-badalona.html"
        }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Neteja de Comerços a Badalona | Botigues i Locals Comercials",
      "description": "Servei de neteja de comerços a Badalona. Deixem la teva botiga o local impecable: aparadors, terres i àrees d'atenció al client. Demana pressupost!",
      "serviceType": "Neteja de Comerços",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Fernet Neteges",
        "url": "https://www.limpiezasfernet.com/ca/",
        "image": "https://www.limpiezasfernet.com/img/logo.jpg",
        "telephone": "+34931050338",
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "https://schema.org/Monday",
              "https://schema.org/Tuesday",
              "https://schema.org/Wednesday",
              "https://schema.org/Thursday",
              "https://schema.org/Friday"
            ],
            "opens": "09:00",
            "closes": "14:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "https://schema.org/Monday",
              "https://schema.org/Tuesday",
              "https://schema.org/Wednesday",
              "https://schema.org/Thursday",
              "https://schema.org/Friday"
            ],
            "opens": "16:30",
            "closes": "18:30"
          }
        ],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Avinguda Alfons XIII núm. 107-109",
          "addressLocality": "Badalona",
          "postalCode": "08912",
          "addressCountry": "ES"
        }
      },
      "areaServed": {
        "@type": "City",
        "name": "Badalona"
      },
      "image": "https://www.limpiezasfernet.com/img/limpieza-comercios-tiendas-badalona.jpg"
    }
  ]
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  esLink={esLink}
  caLink={caLink}
  jsonLd={jsonLd}
  lang="ca"
  basePath="../.."
  currentPage="neteja-comercos-badalona.html"
  extraCss={["../../servicios/servicios.css"]}
>
<section class="hero-servicio">
      <div class="container">
        <h1>Neteja de comerços a Badalona</h1>
        <p>Deixem el teu local impecable per rebre els teus clients</p>
        <div>
          <a href="tel:+34931050338" class="cta-phone">📞 Truca gratis: 931 050 338</a>
          <a href="../../ca/contacte.html" class="cta-button secondary">Pressupost sense compromís en 24h</a>
        </div>
      </div>
    </section>
    <section class="servicio-detalle">
      <div class="container">
        <h2 class="section-title">Neteja de comerços a Badalona</h2>
        <p class="section-subtitle">Serveis de neteja per a comerços a Badalona: aparadors, terres, emprovadors i àrees d'atenció al client. Horaris fora d'obertura.</p>
        <div class="servicios-incluidos">
          <div class="servicio-item"><h3>🏪 Neteja d'aparadors</h3>
<ul>
<li>Neteja sense marques per a més visibilitat</li>
<li>Manteniment regular per a aparadors comercials</li>
<li>Tractaments antiestàtics i antihuellas</li>
</ul>
</div>
<div class="servicio-item"><h3>🧾 Àrees d'atenció al client</h3>
<ul>
<li>Desinfecció de taulells i TPV</li>
<li>Control de pols i manteniment de prestatgeries</li>
<li>Obertures i tancaments amb servei programat</li>
</ul>
</div>
<div class="servicio-item"><h3>🧼 Terres i emprovadors</h3>
<ul>
<li>Fregat profund i eliminació de taques</li>
<li>Tractaments d'abrillantat segons el material</li>
<li>Manteniment nocturn per no interferir en l'activitat</li>
</ul>
</div>
        </div>
      </div>
    </section>
    <section class="proceso">
      <div class="container">
        <h2 class="section-title">El nostre procés de treball</h2>
        <div class="proceso-grid">
          <div class="step"><div class="step-icon">1</div><h3>Contacte i avaluació</h3><p>Estudiem les teves necessitats i visitem l'espai per preparar un pla a mida.</p></div>
          <div class="step"><div class="step-icon">2</div><h3>Proposta i pressupost</h3><p>Enviem un pressupost detallat amb freqüències i materials a utilitzar.</p></div>
          <div class="step"><div class="step-icon">3</div><h3>Execució</h3><p>L'equip qualificat executa el servei amb maquinària i productes professionals.</p></div>
          <div class="step"><div class="step-icon">4</div><h3>Control de qualitat</h3><p>Revisió final de les tasques incloses en el servei.</p></div>
        </div>
      </div>
    </section>
    <section class="cta-seccion">
      <div class="container">
        <h2>Vols un espai impecable sense preocupacions?</h2>
        <p>Contacta amb nosaltres i rep una proposta adaptada al teu comerç o negoci a Badalona.</p>
        <a href="../../ca/contacte.html" class="cta-button">Sol·licitar proposta en 24h</a>
      </div>
    </section>
</BaseLayout>
