---
import BaseLayout from '@layouts/BaseLayout.astro';

const title = "Neteja de Clíniques a Badalona | Fernet Neteges";
const description = "Neteja de clíniques, consultes i centres de salut a Badalona. Consulta quins espais i tasques pot incloure el servei.";
const keywords = "neteja cliniques Badalona, neteja centres medics Badalona, desinfeccio cliniques Badalona";
const canonical = "https://www.limpiezasfernet.com/ca/serveis/neteja-cliniques-badalona.html";
const esLink = "https://www.limpiezasfernet.com/servicios/limpieza-clinicas-badalona.html";
const caLink = "https://www.limpiezasfernet.com/ca/serveis/neteja-cliniques-badalona.html";
const jsonLd = [
  [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inici",
          "item": "https://www.limpiezasfernet.com/ca/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Serveis",
          "item": "https://www.limpiezasfernet.com/ca/#serveis"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Neteja de Clíniques a Badalona",
          "item": "https://www.limpiezasfernet.com/ca/serveis/neteja-cliniques-badalona.html"
        }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Neteja de Clíniques a Badalona | Centres Mèdics i Consultes",
      "description": "Servei de neteja i desinfecció per a clíniques, consultes i centres de salut a Badalona. Protocols d'higiene per a entorns sanitaris.",
      "serviceType": "Neteja de Clíniques",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Fernet Neteges",
        "url": "https://www.limpiezasfernet.com/ca/",
        "image": "https://www.limpiezasfernet.com/img/logo.jpg",
        "telephone": "+34931050338",
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "https://schema.org/Monday",
              "https://schema.org/Tuesday",
              "https://schema.org/Wednesday",
              "https://schema.org/Thursday",
              "https://schema.org/Friday"
            ],
            "opens": "09:00",
            "closes": "14:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "https://schema.org/Monday",
              "https://schema.org/Tuesday",
              "https://schema.org/Wednesday",
              "https://schema.org/Thursday",
              "https://schema.org/Friday"
            ],
            "opens": "16:30",
            "closes": "18:30"
          }
        ],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Avinguda Alfons XIII núm. 107-109",
          "addressLocality": "Badalona",
          "postalCode": "08912",
          "addressCountry": "ES"
        }
      },
      "areaServed": {
        "@type": "City",
        "name": "Badalona"
      },
      "image": "https://www.limpiezasfernet.com/img/limpieza-clinicas.jpeg"
    }
  ]
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  esLink={esLink}
  caLink={caLink}
  jsonLd={jsonLd}
  lang="ca"
  basePath="../.."
  currentPage="neteja-cliniques-badalona.html"
  extraCss={["../../servicios/servicios.css"]}
>
<section class="hero-servicio">
      <div class="container">
        <h1>Neteja de clíniques a Badalona</h1>
        <p>Neteja i desinfecció adaptades a cada centre sanitari</p>
        <div>
          <a href="tel:+34931050338" class="cta-phone">📞 Truca gratis: 931 050 338</a>
          <a href="../contacte.html" class="cta-button secondary">Pressupost sense compromís en 24h</a>
        </div>
      </div>
    </section>
    <section class="servicio-detalle">
      <div class="container">
        <h2 class="section-title">Neteja especialitzada per a centres clínics</h2>
        <p class="section-subtitle">Oferim un servei de neteja i desinfecció adaptat a les necessitats específiques de clíniques dentals, centres de fisioteràpia, consultes mèdiques i altres espais de salut a Badalona.</p>
        <div class="servicios-incluidos">
          <div class="servicio-item"><h3>⚕️ Sales d'espera i recepció</h3>
<ul>
<li>Desinfecció de mobiliari i superfícies d'alt contacte</li>
<li>Neteja de terres i zones de pas</li>
<li>Manteniment d'un ambient acollidor i segur</li>
</ul>
</div>
<div class="servicio-item"><h3>🩺 Consultes i sales de tractament</h3>
<ul>
<li>Protocols estrictes de neteja i desinfecció</li>
<li>Gestió adequada de residus no perillosos</li>
<li>Higienització d'equips i superfícies de treball</li>
</ul>
</div>
<div class="servicio-item"><h3>🚻 Banys i zones comunes</h3>
<ul>
<li>Desinfecció diària de sanitaris i aixetes</li>
<li>Reposició de consumibles higiènics</li>
<li>Control d'olors i ventilació</li>
</ul>
</div>
        </div>
      </div>
    </section>
    <section class="proceso">
      <div class="container">
        <h2>El nostre procés de treball</h2>
        <div class="proceso-grid">
          <div class="step"><div class="step-icon">1</div><h3>Anàlisi de necessitats</h3><p>Avaluem les característiques de la clínica i els requisits d'higiene per dissenyar un pla de neteja específic.</p></div>
          <div class="step"><div class="step-icon">2</div><h3>Proposta personalitzada</h3><p>Presentem un pressupost detallat que inclou les tasques, freqüències i productes a utilitzar.</p></div>
          <div class="step"><div class="step-icon">3</div><h3>Execució professional</h3><p>El nostre equip qualificat aplica els protocols de neteja i desinfecció amb la màxima rigorositat.</p></div>
          <div class="step"><div class="step-icon">4</div><h3>Supervisió i qualitat</h3><p>Realitzem controls de qualitat periòdics per assegurar que es compleixen els estàndards d'higiene.</p></div>
        </div>
      </div>
    </section>
    <section class="cta-seccion">
      <div class="container">
        <h2>Necessites un entorn clínic impecable?</h2>
        <p>Contacta amb nosaltres i t'oferirem una solució de neteja professional per al teu centre a Badalona.</p>
        <a href="../contacte.html" class="cta-button">Sol·licitar proposta en 24h</a>
      </div>
    </section>
</BaseLayout>
