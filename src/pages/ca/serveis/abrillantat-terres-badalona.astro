  lang="ca"
  basePath="../.."
  currentPage="abrillantat-terres-badalona.html"
  extraCss={["servicios/servicios.css"]}
>
<section class="hero-servicio">
      <div class="container">
        <h1>Abrillantat de terres a Badalona</h1>
        <p>Recuperem la brillantor de terres de marbre, terratzo i hidràulics</p>
        <div>
          <a href="tel:+34931050338" class="cta-phone">📞 Truca gratis: 931 050 338</a>
          <a href="../../ca/contacte.html" class="cta-button secondary">Pressupost sense compromís en 24h</a>
        </div>
      </div>
    </section>
    <section class="servicio-detalle">
      <div class="container">
        <h2 class="section-title">Abrillantat i cristal·litzat de terres a Badalona</h2>
        <p class="section-subtitle">Abrillantat i cristal·litzat de terres a Badalona per a marbre, terratzo i terres industrials. Màquines professionals i segelladors d'alta durabilitat.</p>
        <div class="servicios-incluidos">
          <div class="servicio-item"><h3>✨ Tractament de marbre</h3>
<ul>
<li>Polit i eliminació de ratllades</li>
<li>Aplicació de producte cristal·litzant per a una brillantor duradora</li>
<li>Segellat protector contra taques</li>
</ul>
</div>
<div class="servicio-item"><h3>🛠️ Terratzo i rajoles</h3>
<ul>
<li>Raspat i recuperació de la brillantor</li>
<li>Reparació de juntes i tractament de porus</li>
<li>Manteniment periòdic per preservar l'acabat</li>
</ul>
</div>
<div class="servicio-item"><h3>🏭 Terres industrials</h3>
<ul>
<li>Aplicació de resines i tractaments antilliscants</li>
<li>Protecció contra químics i abrasió</li>
<li>Pla de manteniment industrial</li>
</ul>
</div>
        </div>
      </div>
    </section>
    <section class="proceso">
      <div class="container">
        <h2 class="section-title">El nostre procés de treball</h2>
        <div class="proceso-grid">
          <div class="step"><div class="step-icon">1</div><h3>Contacte i avaluació</h3><p>Estudiem les teves necessitats i visitem l'espai per preparar un pla a mida.</p></div>
          <div class="step"><div class="step-icon">2</div><h3>Proposta i pressupost</h3><p>Enviem un pressupost detallat amb freqüències i materials a utilitzar.</p></div>
          <div class="step"><div class="step-icon">3</div><h3>Execució</h3><p>L'equip qualificat executa el servei amb maquinària i productes professionals.</p></div>
          <div class="step"><div class="step-icon">4</div><h3>Control de qualitat</h3><p>Revisió final de les tasques incloses en el servei.</p></div>
        </div>
      </div>
    </section>
    <section class="cta-seccion">
      <div class="container">
        <h2>Vols un espai impecable sense preocupacions?</h2>
        <p>Sol·licita la teva proposta personalitzada sense compromís en menys de 24 hores.</p>
        <a href="../../ca/contacte.html" class="cta-button">Sol·licitar proposta en 24h</a>
      </div>
    </section>
