  lang="ca"
  basePath=".."
  currentPage="index.html"
  extraCss={[]}
>
<section id="inicio" class="hero home-hero-section">
            <div class="home-hero container">
                <div class="home-hero-copy">
                    <h1>Empresa de neteja professional a Badalona</h1>
                    <p class="hero-subtitle">Oblida't de les preocupacions de manteniment. Mantingues la teva comunitat, empresa o habitatge impecable, saludable i lliure d'estrès amb el nostre equip local de confiança.</p>
                    <div class="cta-container">
                        <a href="tel:+34931050338" class="cta-phone">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.4 15.4 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.1.36 2.3.55 3.6.55a1 1 0 0 1 1 1v3.5a1 1 0 0 1-1 1C10.6 21 3 13.4 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.19 2.45.55 3.58a1 1 0 0 1-.25 1.02z"/></svg>
