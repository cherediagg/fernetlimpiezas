---
import BaseLayout from '@layouts/BaseLayout.astro';

const title = "Limpieza de cristales en Badalona | Fernet Limpiezas";
const description = "Limpieza de ventanas, escaparates y cerramientos en Badalona; consulta también los trabajos con pértiga para zonas en altura.";
const keywords = "limpieza cristales Badalona, limpieza escaparates Badalona, limpieza ventanas Badalona";
const canonical = "https://www.limpiezasfernet.com/servicios/limpieza-cristales-badalona.html";
const esLink = "https://www.limpiezasfernet.com/servicios/limpieza-cristales-badalona.html";
const caLink = "https://www.limpiezasfernet.com/ca/serveis/neteja-vidres-badalona.html";
const jsonLd = [
  [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://www.limpiezasfernet.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Servicios",
          "item": "https://www.limpiezasfernet.com/#servicios"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Limpieza de Cristales en Badalona",
          "item": "https://www.limpiezasfernet.com/servicios/limpieza-cristales-badalona.html"
        }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Limpieza de Cristales en Badalona | Ventanas, Escaparates y Alturas",
      "description": "Servicio de limpieza de cristales en Badalona para ventanas, escaparates y cerramientos. Usamos pértiga para trabajos en altura. ¡Pide presupuesto!",
      "serviceType": "Limpieza de Cristales",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Fernet Limpiezas",
        "url": "https://www.limpiezasfernet.com/",
        "image": "https://www.limpiezasfernet.com/img/logo.jpg",
        "telephone": "+34931050338",
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "https://schema.org/Monday",
              "https://schema.org/Tuesday",
              "https://schema.org/Wednesday",
              "https://schema.org/Thursday",
              "https://schema.org/Friday"
            ],
            "opens": "09:00",
            "closes": "14:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "https://schema.org/Monday",
              "https://schema.org/Tuesday",
              "https://schema.org/Wednesday",
              "https://schema.org/Thursday",
              "https://schema.org/Friday"
            ],
            "opens": "16:30",
            "closes": "18:30"
          }
        ],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Avenida Alfonso XIII nº 107-109",
          "addressLocality": "Badalona",
          "postalCode": "08912",
          "addressCountry": "ES"
        }
      },
      "areaServed": {
        "@type": "City",
        "name": "Badalona"
      },
      "image": "https://www.limpiezasfernet.com/img/limpieza-cristales-escaparates-badalona.jpg"
    }
  ]
