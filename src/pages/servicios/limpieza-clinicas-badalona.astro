---
import BaseLayout from '@layouts/BaseLayout.astro';

const title = "Limpieza de Clínicas en Badalona | Fernet Limpiezas";
const description = "Limpieza de clínicas, consultas y centros de salud en Badalona. Consulta qué espacios y tareas puede incluir el servicio.";
const keywords = "limpieza clinicas Badalona, limpieza centros medicos Badalona, desinfeccion clinicas Badalona";
const canonical = "https://www.limpiezasfernet.com/servicios/limpieza-clinicas-badalona.html";
const esLink = "https://www.limpiezasfernet.com/servicios/limpieza-clinicas-badalona.html";
const caLink = "https://www.limpiezasfernet.com/ca/serveis/neteja-cliniques-badalona.html";
const jsonLd = [
  [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://www.limpiezasfernet.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Servicios",
          "item": "https://www.limpiezasfernet.com/#servicios"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Limpieza de Clínicas en Badalona",
          "item": "https://www.limpiezasfernet.com/servicios/limpieza-clinicas-badalona.html"
        }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Limpieza de Clínicas en Badalona | Centros Médicos y Consultas",
      "description": "Servicio de limpieza y desinfección para clínicas, consultas y centros de salud en Badalona. Protocolos de higiene para entornos sanitarios.",
      "serviceType": "Limpieza de Clínicas",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Fernet Limpiezas",
        "url": "https://www.limpiezasfernet.com/",
        "image": "https://www.limpiezasfernet.com/img/logo.jpg",
        "telephone": "+34931050338",
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "https://schema.org/Monday",
              "https://schema.org/Tuesday",
              "https://schema.org/Wednesday",
              "https://schema.org/Thursday",
              "https://schema.org/Friday"
            ],
            "opens": "09:00",
            "closes": "14:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "https://schema.org/Monday",
              "https://schema.org/Tuesday",
              "https://schema.org/Wednesday",
              "https://schema.org/Thursday",
              "https://schema.org/Friday"
            ],
            "opens": "16:30",
            "closes": "18:30"
          }
        ],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Avenida Alfonso XIII nº 107-109",
          "addressLocality": "Badalona",
          "postalCode": "08912",
          "addressCountry": "ES"
        }
      },
      "areaServed": {
        "@type": "City",
        "name": "Badalona"
      },
      "image": "https://www.limpiezasfernet.com/img/limpieza-clinicas.jpeg"
    }
  ]
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  esLink={esLink}
  caLink={caLink}
  jsonLd={jsonLd}
  lang="es"
  basePath=".."
  currentPage="limpieza-clinicas-badalona.html"
  extraCss={["servicios.css"]}
>
<section class="hero-servicio">
      <div class="container">
        <h1>Limpieza de clínicas en Badalona</h1>
        <p>Limpieza y desinfección adaptadas a cada centro sanitario</p>
        <div>
          <a href="tel:+34931050338" class="cta-phone">📞 Llámanos gratis: 931 050 338</a>
          <a href="../contacto.html" class="cta-button secondary">Presupuesto sin compromiso en 24h</a>
        </div>
      </div>
    </section>
    <section class="servicio-detalle">
      <div class="container">
        <h2 class="section-title">Limpieza especializada para centros clínicos</h2>
        <p class="section-subtitle">Ofrecemos un servicio de limpieza y desinfección adaptado a las necesidades específicas de clínicas dentales, centros de fisioterapia, consultas médicas y otros espacios de salud en Badalona.</p>
        <div class="servicios-incluidos">
          <div class="servicio-item"><h3>⚕️ Salas de espera y recepción</h3>
<ul>
<li>Desinfección de mobiliario y superficies de alto contacto</li>
<li>Limpieza de suelos y zonas de paso</li>
<li>Mantenimiento de un ambiente acogedor y seguro</li>
</ul>
</div>
<div class="servicio-item"><h3>🩺 Consultas y salas de tratamiento</h3>
<ul>
<li>Protocolos estrictos de limpieza y desinfección</li>
<li>Gestión adecuada de residuos no peligrosos</li>
<li>Higienización de equipos y superficies de trabajo</li>
</ul>
</div>
<div class="servicio-item"><h3>🚻 Baños y zonas comunes</h3>
<ul>
<li>Desinfección diaria de sanitarios y griferías</li>
<li>Reposición de consumibles higiénicos</li>
<li>Control de olores y ventilación</li>
</ul>
</div>
        </div>
      </div>
    </section>
    <section class="proceso">
      <div class="container">
        <h2>Nuestro proceso de trabajo</h2>
        <div class="proceso-grid">
          <div class="step"><div class="step-icon">1</div><h3>Análisis de necesidades</h3><p>Evaluamos las características de la clínica y los requisitos de higiene para diseñar un plan de limpieza específico.</p></div>
          <div class="step"><div class="step-icon">2</div><h3>Propuesta personalizada</h3><p>Presentamos un presupuesto detallado que incluye las tareas, frecuencias y productos a utilizar.</p></div>
          <div class="step"><div class="step-icon">3</div><h3>Ejecución profesional</h3><p>Nuestro equipo cualificado aplica los protocolos de limpieza y desinfección con la máxima rigurosidad.</p></div>
          <div class="step"><div class="step-icon">4</div><h3>Supervisión y calidad</h3><p>Realizamos controles de calidad periódicos para asegurar que se cumplen los estándares de higiene.</p></div>
        </div>
      </div>
    </section>
    <section class="cta-seccion">
      <div class="container">
        <h2>¿Necesitas un entorno clínico impecable?</h2>
        <p>Contacta con nosotros y te ofreceremos una solución de limpieza profesional para tu centro en Badalona.</p>
        <a href="../contacto.html" class="cta-button">Solicitar propuesta en 24h</a>
      </div>
    </section>
</BaseLayout>
