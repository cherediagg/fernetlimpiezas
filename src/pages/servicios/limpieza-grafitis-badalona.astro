          "position": 3,
          "name": "Eliminación de Grafitis en Badalona",
          "item": "https://www.limpiezasfernet.com/servicios/limpieza-grafitis-badalona.html"
        }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Eliminación de Grafitis en Badalona | Recuperación de Fachadas",
      "description": "Limpieza de pintadas en fachadas, persianas y muros de Badalona; la técnica se valora según el material y su estado.",
      "serviceType": "Eliminación de Grafitis",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Fernet Limpiezas",
        "url": "https://www.limpiezasfernet.com/",
        "image": "https://www.limpiezasfernet.com/img/logo.jpg",
        "telephone": "+34931050338",
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "https://schema.org/Monday",
              "https://schema.org/Tuesday",
              "https://schema.org/Wednesday",
              "https://schema.org/Thursday",
              "https://schema.org/Friday"
            ],
            "opens": "09:00",
            "closes": "14:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "https://schema.org/Monday",
              "https://schema.org/Tuesday",
              "https://schema.org/Wednesday",
              "https://schema.org/Thursday",
              "https://schema.org/Friday"
            ],
            "opens": "16:30",
            "closes": "18:30"
          }
        ],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Avenida Alfonso XIII nº 107-109",
          "addressLocality": "Badalona",
          "postalCode": "08912",
