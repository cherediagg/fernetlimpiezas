---
import BaseLayout from '@layouts/BaseLayout.astro';

const title = "Eliminación de grafitis en Badalona | Fernet Limpiezas";
const description = "Limpieza de pintadas en fachadas, persianas y muros en Badalona. Consulta las opciones según el material y estado de la superficie.";
const keywords = "eliminacion grafitis Badalona, quitar grafitis Badalona, limpieza fachadas grafitis";
const canonical = "https://www.limpiezasfernet.com/servicios/limpieza-grafitis-badalona.html";
const esLink = "https://www.limpiezasfernet.com/servicios/limpieza-grafitis-badalona.html";
const caLink = "https://www.limpiezasfernet.com/ca/serveis/neteja-grafitis-badalona.html";
const jsonLd = [
  [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://www.limpiezasfernet.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Servicios",
