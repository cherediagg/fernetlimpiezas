---
import BaseLayout from '@layouts/BaseLayout.astro';

const title = "Restauración de suelos en Badalona | Fernet Limpiezas";
const description = "Pulido y tratamiento de suelos de terracota, mármol e hidráulicos en Badalona. Consulta las opciones según el estado del pavimento.";
const keywords = "restauración de suelos Badalona, tratamiento de suelos, pulido de suelos, suelos de terracota, suelos de mármol";
const canonical = "https://www.limpiezasfernet.com/servicios/restauracion-suelos-badalona.html";
const esLink = "https://www.limpiezasfernet.com/servicios/restauracion-suelos-badalona.html";
const caLink = "https://www.limpiezasfernet.com/ca/serveis/restauracio-terres-badalona.html";
const jsonLd = [
  [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://www.limpiezasfernet.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Servicios",
          "item": "https://www.limpiezasfernet.com/#servicios"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Restauración de Suelos en Badalona",
          "item": "https://www.limpiezasfernet.com/servicios/restauracion-suelos-badalona.html"
        }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Restauración de Suelos en Badalona | Terracota, Mármol y más",
      "description": "Servicio de restauración de suelos en Badalona. Expertos en pulido y tratamiento de suelos de terracota, mármol e hidráulicos. ¡Pide presupuesto!",
      "serviceType": "Restauración de Suelos",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Fernet Limpiezas",
        "url": "https://www.limpiezasfernet.com/",
        "image": "https://www.limpiezasfernet.com/img/logo.jpg",
        "telephone": "+34931050338",
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "https://schema.org/Monday",
              "https://schema.org/Tuesday",
              "https://schema.org/Wednesday",
              "https://schema.org/Thursday",
              "https://schema.org/Friday"
            ],
            "opens": "09:00",
            "closes": "14:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "https://schema.org/Monday",
              "https://schema.org/Tuesday",
              "https://schema.org/Wednesday",
              "https://schema.org/Thursday",
              "https://schema.org/Friday"
            ],
            "opens": "16:30",
            "closes": "18:30"
          }
        ],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Avenida Alfonso XIII nº 107-109",
          "addressLocality": "Badalona",
          "postalCode": "08912",
          "addressCountry": "ES"
        }
      },
      "areaServed": {
        "@type": "City",
        "name": "Badalona"
      },
      "image": "https://www.limpiezasfernet.com/img/abrillantado-suelos-profesional-badalona.jpg"
    }
  ]
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  esLink={esLink}
  caLink={caLink}
  jsonLd={jsonLd}
  lang="es"
  basePath=".."
  currentPage="restauracion-suelos-badalona.html"
  extraCss={["servicios/servicios.css"]}
>
<section class="hero-servicio">
      <div class="container">
        <h1>Restauración de suelos en Badalona</h1>
        <p>Devolvemos la belleza original a tus suelos con tratamientos especializados.</p>
        <div>
          <a href="tel:+34931050338" class="cta-phone">📞 Llámanos gratis: 931 050 338</a>
          <a href="../contacto.html" class="cta-button secondary">Presupuesto sin compromiso en 24h</a>
        </div>
      </div>
    </section>
    <section class="servicio-detalle">
      <div class="container">
        <h2 class="section-title">Tratamientos para cada tipo de suelo</h2>
        <p class="section-subtitle">Nos especializamos en la restauración de suelos nobles, eliminando manchas, desgaste y devolviendo su esplendor original con técnicas y productos específicos.</p>
        <div class="servicios-incluidos">
          <div class="servicio-item"><h3>🏺 Suelos de terracota y barro cocido</h3>
              <ul>
                  <li>Limpieza profunda para eliminar manchas de humedad y salitre.</li>
                  <li>Tratamientos de sellado con efecto mate, satinado o brillo.</li>
                  <li>Protección hidrófuga y oleófuga para evitar futuras manchas.</li>
              </ul>
          </div>
          <div class="servicio-item"><h3>💎 Mármol y terrazo</h3>
              <ul>
                  <li>Pulido y rebajado para eliminar arañazos y desgaste.</li>
                  <li>Cristalizado para un brillo de espejo duradero.</li>
                  <li>Recuperación de juntas y reparación de pequeñas imperfecciones.</li>
              </ul>
          </div>
          <div class="servicio-item"><h3>💠 Suelos hidráulicos</h3>
              <ul>
                  <li>Limpieza cuidadosa para no dañar los pigmentos originales.</li>
                  <li>Aplicación de ceras naturales y selladores específicos.</li>
                  <li>Recuperación del color y protección del mosaico.</li>
              </ul>
          </div>
        </div>
      </div>
    </section>
    <section class="proceso">
      <div class="container">
        <h2 class="section-title">Nuestro proceso de restauración</h2>
        <div class="proceso-grid">
          <div class="step"><div class="step-icon">1</div><h3>Diagnóstico del suelo</h3><p>Analizamos el estado del suelo y el tipo de material para definir el tratamiento adecuado.</p></div>
          <div class="step"><div class="step-icon">2</div><h3>Prueba y presupuesto</h3><p>Realizamos una pequeña prueba si es necesario y te entregamos un presupuesto cerrado.</p></div>
          <div class="step"><div class="step-icon">3</div><h3>Ejecución del tratamiento</h3><p>Nuestro equipo aplica el tratamiento con maquinaria y productos de alta gama.</p></div>
          <div class="step"><div class="step-icon">4</div><h3>Acabado y mantenimiento</h3><p>Te entregamos el suelo restaurado y te asesoramos sobre su mantenimiento.</p></div>
        </div>
      </div>
    </section>
    <section class="cta-seccion">
      <div class="container">
        <h2>¿Quieres recuperar tus suelos?</h2>
        <p>Contacta con nosotros para un diagnóstico y presupuesto sin compromiso en Badalona.</p>
        <a href="../contacto.html" class="cta-button">Solicitar propuesta en 24h</a>
      </div>
    </section>
</BaseLayout>
