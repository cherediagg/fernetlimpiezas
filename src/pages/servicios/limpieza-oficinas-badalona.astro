            <thead>
              <tr style="background: var(--verde-principal); color: #fff; text-align: left;">
                <th style="padding: 12px 16px;">Zona empresarial / Polígono</th>
                <th style="padding: 12px 16px;">Horarios adaptados</th>
                <th style="padding: 12px 16px;">Planes de limpieza</th>
                <th style="padding: 12px 16px;">Respuesta rápida</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 12px 16px;"><strong>Polígono Les Guixeres</strong></td>
                <td style="padding: 12px 16px;">Mañanas / Tardes / Noches</td>
