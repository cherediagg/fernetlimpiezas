---
import BaseLayout from '@layouts/BaseLayout.astro';

const title = "Limpieza a fondo en Badalona | Fernet Limpiezas";
const description = "Limpieza profunda para viviendas y oficinas en Badalona. Consulta las tareas que necesitas incluir y solicita una propuesta.";
const keywords = "limpieza a fondo Badalona, limpieza profunda Badalona, limpiezas intensivas Badalona";
const canonical = "https://www.limpiezasfernet.com/servicios/limpieza-fondo-badalona.html";
const esLink = "https://www.limpiezasfernet.com/servicios/limpieza-fondo-badalona.html";
const caLink = "https://www.limpiezasfernet.com/ca/serveis/neteja-fons-badalona.html";
const jsonLd = [
  [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://www.limpiezasfernet.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Servicios",
          "item": "https://www.limpiezasfernet.com/#servicios"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Limpiezas a Fondo Puntuales en Badalona",
          "item": "https://www.limpiezasfernet.com/servicios/limpieza-fondo-badalona.html"
        }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Limpiezas a Fondo Puntuales en Badalona | Limpieza Intensiva",
      "description": "Servicio de limpieza a fondo en Badalona para hogares y oficinas. Realizamos una limpieza profunda y detallada para dejar tu espacio impecable. ¡Pide presupuesto!",
      "serviceType": "Limpiezas a Fondo Puntuales",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Fernet Limpiezas",
        "url": "https://www.limpiezasfernet.com/",
        "image": "https://www.limpiezasfernet.com/img/logo.jpg",
        "telephone": "+34931050338",
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "https://schema.org/Monday",
              "https://schema.org/Tuesday",
              "https://schema.org/Wednesday",
              "https://schema.org/Thursday",
              "https://schema.org/Friday"
            ],
            "opens": "09:00",
            "closes": "14:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "https://schema.org/Monday",
              "https://schema.org/Tuesday",
              "https://schema.org/Wednesday",
              "https://schema.org/Thursday",
              "https://schema.org/Friday"
            ],
            "opens": "16:30",
            "closes": "18:30"
          }
        ],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Avenida Alfonso XIII nº 107-109",
          "addressLocality": "Badalona",
          "postalCode": "08912",
          "addressCountry": "ES"
        }
      },
      "areaServed": {
        "@type": "City",
        "name": "Badalona"
      },
      "image": "https://www.limpiezasfernet.com/img/limpieza-general-badalona.jpg"
    }
  ]
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  esLink={esLink}
  caLink={caLink}
  jsonLd={jsonLd}
  lang="es"
  basePath=".."
  currentPage="limpieza-fondo-badalona.html"
  extraCss={["servicios.css"]}
>
<section class="hero-servicio">
      <div class="container">
        <h1>Limpieza a fondo en Badalona</h1>
        <p>Servicio de limpieza profunda para hogares, oficinas y locales</p>
        <div>
          <a href="tel:+34931050338" class="cta-phone">📞 Llámanos gratis: 931 050 338</a>
          <a href="../contacto.html" class="cta-button secondary">Presupuesto sin compromiso en 24h</a>
        </div>
      </div>
    </section>
    <section class="servicio-detalle">
      <div class="container">
        <h2 class="section-title">Limpiezas a fondo puntuales en Badalona</h2>
        <p class="section-subtitle">Limpiezas a fondo puntuales en Badalona para hogares, locales y oficinas. Eliminación de suciedad incrustada y tratamiento intensivo de superficies.</p>
        <div class="servicios-incluidos">
          <div class="servicio-item"><h3>🧼 Limpieza profunda de cocinas y baños</h3>
<ul>
<li>Desincrustado de cal y restos de grasa</li>
<li>Desinfección y eliminación de olores</li>
<li>Tratamientos especiales para juntas y azulejos</li>
</ul>
</div>
<div class="servicio-item"><h3>🧹 Mobiliario y tapicerías</h3>
<ul>
<li>Limpieza y desinfección de sofás y cortinas</li>
<li>Eliminación de manchas con técnicas profesionales</li>
<li>Secado rápido y restauración de tejidos</li>
</ul>
</div>
<div class="servicio-item"><h3>🧰 Preparación para eventos</h3>
<ul>
<li>Limpieza intensiva previa a eventos o aperturas</li>
<li>Coordinación con proveedores y logística</li>
<li>Servicios express bajo pedido</li>
</ul>
</div>
        </div>
      </div>
    </section>
    <section class="proceso">
      <div class="container">
        <h2>Nuestro proceso de trabajo</h2>
        <div class="proceso-grid">
          <div class="step"><div class="step-icon">1</div><h3>Contacto y evaluación</h3><p>Estudiamos tus necesidades y visitamos el espacio para preparar un plan a medida.</p></div>
          <div class="step"><div class="step-icon">2</div><h3>Propuesta y presupuesto</h3><p>Enviamos un presupuesto detallado con frecuencias y materiales a utilizar.</p></div>
          <div class="step"><div class="step-icon">3</div><h3>Ejecución</h3><p>Equipo cualificado ejecuta el servicio con maquinaria y productos profesionales.</p></div>
          <div class="step"><div class="step-icon">4</div><h3>Control de calidad</h3><p>Revisión final de las tareas incluidas en el servicio.</p></div>
        </div>
      </div>
    </section>
    <section class="cta-seccion">
      <div class="container">
        <h2>¿Quieres un espacio impecable sin preocupaciones?</h2>
        <p>Solicita tu propuesta personalizada sin compromiso en menos de 24 horas.</p>
        <a href="../contacto.html" class="cta-button">Solicitar propuesta en 24h</a>
      </div>
    </section>
</BaseLayout>
