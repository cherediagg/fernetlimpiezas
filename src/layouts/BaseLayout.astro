---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  author?: string;
  robots?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  ogImage?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  canonical?: string;
  esLink?: string;
  caLink?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  lang?: 'es' | 'ca';
  basePath?: string;
  currentPage?: string;
  extraCss?: string[];
}

const {
  title,
  description,
  keywords = 'limpieza Badalona, servicios limpieza, Fernet Limpiezas',
  author = 'Fernet Limpiezas',
  robots = 'index, follow',
  ogType = 'business.business',
  ogTitle = title,
  ogDescription = description,
  ogUrl = 'https://www.limpiezasfernet.com/',
  ogImage = 'https://www.limpiezasfernet.com/img/logo.jpg',
  twitterTitle = title,
  twitterDescription = description,
  twitterImage = ogImage,
  canonical = ogUrl,
  esLink = 'https://www.limpiezasfernet.com/',
  caLink = 'https://www.limpiezasfernet.com/ca/',
  jsonLd,
  lang = 'es',
  basePath = '',
  currentPage = '',
  extraCss = []
} = Astro.props;

const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    {keywords && <meta name="keywords" content={keywords}>}
    <meta name="author" content={author}>
    <meta name="robots" content={robots}>
    <meta name="theme-color" content="#2e8b57" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={lang === 'ca' ? 'Fernet Neteges' : 'Fernet Limpiezas'} />
    <meta property="og:locale" content={lang === 'ca' ? 'ca_ES' : 'es_ES'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    <meta name="twitter:image" content={twitterImage} />
    <link rel="canonical" href={canonical}>
    <link rel="alternate" hreflang="es" href={esLink}>
    <link rel="alternate" hreflang="ca" href={caLink}>
    <link rel="alternate" type="text/markdown" href="https://www.limpiezasfernet.com/llms.txt">
    <link rel="alternate" hreflang="x-default" href="https://www.limpiezasfernet.com/">

    {jsonLdArray.map(item => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <link rel="stylesheet" href={`${basePath}/styles.css`}>
    {extraCss.map(cssPath => (
      <link rel="stylesheet" href={`${basePath}/${cssPath}`}>
    ))}
</head>
<body>
    <Header
        lang={lang}
        basePath={basePath}
        esLink={esLink}
        caLink={caLink}
        currentPage={currentPage}
    />
    <main id="main-content">
        <slot />
    </main>
    <WhatsAppFloat lang={lang} />
    <Footer lang={lang} basePath={basePath} />
</body>
</html>
