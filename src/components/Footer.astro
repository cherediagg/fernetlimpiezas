---
interface Props {
  lang?: 'es' | 'ca';
  basePath?: string;
}

const { lang = 'es', basePath = '' } = Astro.props;
const isSpanish = lang === 'es';

const i18n = {
  es: {
    companyName: 'Fernet Limpiezas',
    companyDescription: 'Empresa de limpieza profesional en Badalona. Soluciones a medida para comunidades, empresas y particulares con total transparencia.',
    contactTitle: 'Contacto',
    address: 'Avenida Alfonso XIII nº 107-109, Badalona, Barcelona',
    linksTitle: 'Enlaces de interés',
    rates: 'Tarifas',
    budget: 'Presupuesto',
    howToArrive: 'Cómo llegar',
    contact: 'Contacto',
    gallery: 'Galería',
    employment: 'Empleo',
    servicesTitle: 'Servicios en Badalona',
    copyright: `© ${new Date().getFullYear()} Fernet Limpiezas. Todos los derechos reservados. | Servicios de Limpieza Profesional en Badalona`,
    copyrightDescription: 'Empresa de limpieza especialista en comunidades, oficinas, comercios, escuelas, fábricas y centros clínicos en Badalona',
    services: {
      comunidades: 'Comunidades de Vecinos',
      oficinas: 'Oficinas',
      comercios: 'Comercios',
      docentes: 'Centros Docentes',
      grafitis: 'Eliminación de Grafitis',
      abrillantado: 'Abrillantado y Cristalizado',
      particulares: 'Particulares',
      fondo: 'Limpiezas a Fondo',
      obra: 'Finales de Obra',
      cristales: 'Cristales',
      parkings: 'Parkings',
      industrial: 'Limpieza Industrial'
    }
  },
  ca: {
    companyName: 'Fernet Neteges',
    companyDescription: 'Empresa de neteja professional a Badalona. Solucions a mida per a comunitats, empreses i particulars amb total transparència.',
    contactTitle: 'Contacte',
    address: 'Avinguda Alfons XIII núm. 107-109, Badalona, Barcelona',
    linksTitle: "Enllaços d'interès",
    rates: 'Tarifes',
    budget: 'Pressupost',
    howToArrive: 'Com arribar',
    contact: 'Contacte',
    gallery: 'Galeria',
    employment: 'Feina',
    servicesTitle: 'Serveis a Badalona',
    copyright: `© ${new Date().getFullYear()} Fernet Neteges. Tots els drets reservats. | Serveis de Neteja Professional a Badalona`,
    copyrightDescription: 'Empresa de neteja especialitzada en comunitats, oficines, comerços, escoles, fàbriques i centres clínics a Badalona',
    services: {
      comunidades: 'Comunitats de Veïns',
      oficinas: 'Oficines',
      comercios: 'Comerços',
      docentes: 'Centres Docents',
      grafitis: 'Eliminació de Grafitis',
      abrillantado: 'Abrillantat i Cristal·litzat',
      particulares: 'Particulars',
      fondo: 'Neteges a Fons',
      obra: "Finals d'Obra",
      cristales: 'Vidres',
      parkings: 'Pàrquings',
      industrial: 'Neteja Industrial'
    }
  }
};

const t = i18n[lang];

const pageLinks = isSpanish ? {
  rates: `${basePath}/tarifas.html`,
  budget: `${basePath}/presupuesto.html`,
  howToArrive: `${basePath}/como-llegar.html`,
  contact: `${basePath}/contacto.html`,
  gallery: `${basePath}/galeria.html`,
  employment: `${basePath}/empleo.html`,
  serviceRoot: `${basePath}/servicios`
} : {
  rates: `${basePath}/ca/tarifes.html`,
  budget: `${basePath}/ca/pressupost.html`,
  howToArrive: `${basePath}/ca/com-arribar.html`,
  contact: `${basePath}/ca/contacte.html`,
  gallery: `${basePath}/ca/galeria.html`,
  employment: `${basePath}/ca/feina.html`,
  serviceRoot: `${basePath}/ca/serveis`
};

const servicePages = {
  comunidades: isSpanish ? 'limpieza-comunidades-badalona.html' : 'neteja-comunitats-badalona.html',
  oficinas: isSpanish ? 'limpieza-oficinas-badalona.html' : 'neteja-oficines-badalona.html',
  comercios: isSpanish ? 'limpieza-comercios-badalona.html' : 'neteja-comercos-badalona.html',
  docentes: isSpanish ? 'limpieza-centros-docentes-badalona.html' : 'neteja-centres-docents-badalona.html',
  grafitis: isSpanish ? 'limpieza-grafitis-badalona.html' : 'neteja-grafitis-badalona.html',
  abrillantado: isSpanish ? 'abrillantado-suelos-badalona.html' : 'abrillantat-terres-badalona.html',
  particulares: isSpanish ? 'limpieza-particulares-badalona.html' : 'neteja-particulars-badalona.html',
  fondo: isSpanish ? 'limpieza-fondo-badalona.html' : 'neteja-fons-badalona.html',
  obra: isSpanish ? 'limpieza-finales-obra-badalona.html' : 'neteja-finals-obra-badalona.html',
  cristales: isSpanish ? 'limpieza-cristales-badalona.html' : 'neteja-vidres-badalona.html',
  parkings: isSpanish ? 'limpieza-parkings-badalona.html' : 'neteja-parkings-badalona.html',
  industrial: isSpanish ? 'limpieza-industrial-badalona.html' : 'neteja-industrial-badalona.html'
};
---

<footer>
  <div class="footer-container">
    <div class="footer-contact">
      <h4>{t.companyName}</h4>
      <p>{t.companyDescription}</p>
      <br><br>
      <h4>{t.contactTitle}</h4>
      <p>{t.address}</p>
      <p><a href="tel:+34931050338">931 050 338</a></p>
      <p><a href="mailto:info@limpiezasfernet.com">info@limpiezasfernet.com</a></p>
    </div>
    <div class="footer-about">
      <div class="footer-links-secondary">
        <h4>{t.linksTitle}</h4>
        <ul>
          <li><a href={pageLinks.rates}>{t.rates}</a></li>
          <li><a href={pageLinks.budget}>{t.budget}</a></li>
          <li><a href={pageLinks.howToArrive}>{t.howToArrive}</a></li>
          <li><a href={pageLinks.contact}>{t.contact}</a></li>
          <li><a href={pageLinks.gallery}>{t.gallery}</a></li>
          <li><a href={pageLinks.employment}>{t.employment}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-links">
      <h4>{t.servicesTitle}</h4>
      <ul>
        <li><a href={`${pageLinks.serviceRoot}/${servicePages.comunidades}`}>{t.services.comunidades}</a></li>
        <li><a href={`${pageLinks.serviceRoot}/${servicePages.oficinas}`}>{t.services.oficinas}</a></li>
        <li><a href={`${pageLinks.serviceRoot}/${servicePages.comercios}`}>{t.services.comercios}</a></li>
        <li><a href={`${pageLinks.serviceRoot}/${servicePages.docentes}`}>{t.services.docentes}</a></li>
        <li><a href={`${pageLinks.serviceRoot}/${servicePages.grafitis}`}>{t.services.grafitis}</a></li>
        <li><a href={`${pageLinks.serviceRoot}/${servicePages.abrillantado}`}>{t.services.abrillantado}</a></li>
        <li><a href={`${pageLinks.serviceRoot}/${servicePages.particulares}`}>{t.services.particulares}</a></li>
        <li><a href={`${pageLinks.serviceRoot}/${servicePages.fondo}`}>{t.services.fondo}</a></li>
        <li><a href={`${pageLinks.serviceRoot}/${servicePages.obra}`}>{t.services.obra}</a></li>
        <li><a href={`${pageLinks.serviceRoot}/${servicePages.cristales}`}>{t.services.cristales}</a></li>
        <li><a href={`${pageLinks.serviceRoot}/${servicePages.parkings}`}>{t.services.parkings}</a></li>
        <li><a href={`${pageLinks.serviceRoot}/${servicePages.industrial}`}>{t.services.industrial}</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p>{t.copyright}</p>
    <p>{t.copyrightDescription}</p>
  </div>
</footer>
